{
  "model": {
    "model_name": "orion-300m",
    "model_version": "0.1.0",
    "tokenizer_version": "1.0",
    "vocab_size": 32768,
    "num_layers": 28,
    "hidden_size": 960,
    "num_heads": 15,
    "num_kv_heads": 5,
    "intermediate_size": 2560,
    "pretraining_length": 2048,
    "context_length": 4096,
    "max_generation_tokens": 512,
    "rope_theta": 100000.0,
    "rms_norm_eps": 1e-05,
    "z_loss_coefficient": 0.0001,
    "dropout": 0.0,
    "pad_token_id": 0,
    "bos_token_id": 5,
    "eos_token_id": 6,
    "abstain_token_id": 7,
    "end_token_id": 19
  },
  "trainer": {
    "max_steps": 3,
    "grad_accum_steps": 1,
    "max_grad_norm": 1.0,
    "precision": "fp32",
    "log_every_steps": 1,
    "checkpoint_every_steps": 3,
    "checkpoint_dir": "checkpoints/orion-300m",
    "seed": 1729,
    "loss_spike_factor": 5.0,
    "loss_ema_decay": 0.98,
    "rollback_on_spike": false,
    "lower_lr_on_rollback": 0.5,
    "gradient_checkpointing": true
  },
  "sequence_length": 128,
  "batch_size": 1,
  "learning_rate": 0.0003,
  "weight_decay": 0.1,
  "warmup_steps": 1,
  "scheduler": "wsd"
}
