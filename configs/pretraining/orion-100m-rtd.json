{
  "model": {
    "model_name": "orion-100m",
    "model_version": "0.1.0",
    "tokenizer_version": "1.0",
    "vocab_size": 32768,
    "num_layers": 16,
    "hidden_size": 640,
    "num_heads": 10,
    "intermediate_size": 1728,
    "max_sequence_length": 2048,
    "base_training_length": 1024,
    "local_window": 128,
    "global_attention_every": 4,
    "rope_theta_local": 10000.0,
    "rope_theta_global": 160000.0,
    "layer_norm_eps": 1e-5,
    "dropout": 0.0,
    "pad_token_id": 0,
    "cls_token_id": 2,
    "sep_token_id": 3
  },
  "trainer": {
    "max_steps": 1000,
    "grad_accum_steps": 1,
    "max_grad_norm": 1.0,
    "precision": "fp32",
    "log_every_steps": 10,
    "checkpoint_every_steps": 100,
    "checkpoint_dir": "checkpoints/orion-100m",
    "seed": 1729,
    "loss_spike_factor": 5.0,
    "loss_ema_decay": 0.98,
    "rollback_on_spike": false,
    "lower_lr_on_rollback": 0.5
  },
  "sequence_length": 512,
  "batch_size": 8,
  "learning_rate": 0.0002,
  "weight_decay": 0.01,
  "warmup_steps": 100,
  "scheduler": "wsd",
  "masking_granularity": "whole_word",
  "rtd_weight": 50.0,
  "mask_rate": 0.2,
  "generator_layers": 8,
  "generator_hidden_size": 384,
  "generator_heads": 6,
  "generator_intermediate_size": 1024
}
