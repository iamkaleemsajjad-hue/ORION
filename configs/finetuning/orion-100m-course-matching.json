{
  "trainer": {
    "max_steps": 1000,
    "grad_accum_steps": 1,
    "max_grad_norm": 1.0,
    "precision": "bf16",
    "log_every_steps": 10,
    "checkpoint_every_steps": 100,
    "checkpoint_dir": "checkpoints/orion-100m-course-matching",
    "seed": 1729,
    "loss_spike_factor": 5.0,
    "loss_ema_decay": 0.98,
    "rollback_on_spike": false,
    "lower_lr_on_rollback": 0.5
  },
  "sequence_length": 256,
  "batch_size": 32,
  "negative_courses": 32,
  "learning_rate": 0.00001,
  "weight_decay": 0.01,
  "warmup_steps": 50,
  "scheduler": "wsd",
  "unknown_margin": 0.3,
  "unknown_weight": 1.0
}
