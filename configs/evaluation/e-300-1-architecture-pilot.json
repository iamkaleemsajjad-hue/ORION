{
  "model": {
    "model_name": "orion-300m-pilot",
    "model_version": "0.1.0",
    "tokenizer_version": "1.0",
    "vocab_size": 32768,
    "num_layers": 12,
    "hidden_size": 512,
    "num_heads": 8,
    "num_kv_heads": 4,
    "intermediate_size": 1365,
    "pretraining_length": 512,
    "context_length": 1024,
    "max_generation_tokens": 256,
    "rope_theta": 100000.0,
    "rms_norm_eps": 0.00001,
    "z_loss_coefficient": 0.0001,
    "dropout": 0.0,
    "pad_token_id": 0,
    "bos_token_id": 5,
    "eos_token_id": 6,
    "abstain_token_id": 7,
    "end_token_id": 19
  },
  "trainer": {
    "max_steps": 500,
    "grad_accum_steps": 1,
    "max_grad_norm": 1.0,
    "precision": "bf16",
    "log_every_steps": 10,
    "checkpoint_every_steps": 100,
    "checkpoint_dir": "experiments/tutor/e-300-1",
    "seed": 1729,
    "loss_spike_factor": 5.0,
    "loss_ema_decay": 0.98,
    "rollback_on_spike": false,
    "lower_lr_on_rollback": 0.5
  },
  "candidates": ["decoder", "prefix_lm", "encoder_decoder"],
  "encoder_decoder_layers": [6, 6],
  "sequence_length": 512,
  "batch_size": 4,
  "learning_rate": 0.0003,
  "weight_decay": 0.1,
  "warmup_steps": 50,
  "scheduler": "wsd"
}
